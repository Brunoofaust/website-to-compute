<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lovi Buquês — Loja</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gray-50 p-6 flex flex-col items-center">
  <header class="w-full max-w-5xl flex items-center justify-between mb-6">
    <div>
      <h1 class="text-3xl font-extrabold">Lovi Buquês — Loja</h1>
      <p class="text-sm text-gray-600">Catálogo rápido — fechamento via WhatsApp</p>
    </div>

    <div class="flex items-center gap-3">
      <button id="toggleCart" class="flex items-center gap-2 px-4 py-2 rounded-2xl shadow text-sm bg-white">
        🛒 Carrinho (<span id="cartCount">0</span>)
      </button>
      <a href="https://wa.me/5511999998888" target="_blank" class="px-4 py-2 rounded-2xl shadow bg-green-500 text-white text-sm">
        Falar no WhatsApp
      </a>
    </div>
  </header>

  <main class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-3 gap-6">
    <section class="lg:col-span-2">
      <div id="products" class="grid grid-cols-1 sm:grid-cols-2 gap-6"></div>
    </section>

    <aside id="cartBox" class="bg-white rounded-2xl shadow p-4 hidden">
      <h3 class="text-xl font-semibold mb-3">Resumo do Pedido</h3>
      <div id="cartItems" class="flex flex-col gap-3"></div>
      <div class="border-t pt-3 flex flex-col gap-2">
        <div class="flex justify-between text-sm text-gray-600">
          <span>Subtotal</span>
          <span id="subtotal">R$ 0,00</span>
        </div>
        <div class="flex justify-between font-bold text-lg">
          <span>Total</span>
          <span id="total">R$ 0,00</span>
        </div>
        <div class="mt-3 flex gap-2">
          <button id="checkoutBtn" class="flex-1 px-4 py-3 rounded-2xl bg-green-600 text-white font-semibold shadow">
            Finalizar pelo WhatsApp
          </button>
          <button id="clearCart" class="px-4 py-3 rounded-2xl bg-gray-100">Limpar</button>
        </div>
      </div>
    </aside>
  </main>

  <footer class="w-full max-w-5xl text-center text-sm text-gray-500 mt-8">
    Modelo criado para fechamento de pedidos via WhatsApp • Substitua o número do WhatsApp no código.
  </footer>

  <script>
    const MY_WHATSAPP_NUMBER = "5511999998888"; // coloque seu número

    const products = [
      {id: "p1", name: "Buquê Classic (6 rosas)", price: 59.9, image: "https://images.unsplash.com/photo-1508610048659-a06a9bfa0b3b?q=80", description: "Buquê clássico de 6 rosas."},
      {id: "p2", name: "Buquê Premium (12 rosas)", price: 129.9, image: "https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80", description: "Buquê premium com 12 rosas."},
      {id: "p3", name: "Box Maternidade", price: 89.0, image: "https://images.unsplash.com/photo-1545239351-1141bd82e8a6?q=80", description: "Box delicado para maternidade."},
    ];

    let cart = [];

    function formatBRL(value){
      return value.toLocaleString("pt-BR", {style: "currency", currency: "BRL"});
    }

    function renderProducts(){
      const container = document.getElementById("products");
      container.innerHTML = "";
      products.forEach(p => {
        container.innerHTML += `
          <article class="bg-white rounded-2xl shadow p-4 flex flex-col">
            <img src="${p.image}" class="h-48 w-full object-cover rounded-xl mb-3"/>
            <h2 class="text-xl font-semibold">${p.name}</h2>
            <p class="text-sm text-gray-600 mt-1">${p.description}</p>
            <div class="mt-4 flex items-center justify-between">
              <div class="text-lg font-bold">${formatBRL(p.price)}</div>
              <button onclick="addToCart('${p.id}')" class="px-3 py-1 rounded-full bg-pink-500 text-white text-sm shadow">Adicionar</button>
            </div>
          </article>`;
      });
    }

    function renderCart(){
      document.getElementById("cartBox").classList.remove("hidden");
      const itemsBox = document.getElementById("cartItems");
      itemsBox.innerHTML = "";
      let subtotal = 0;
      cart.forEach(item => {
        subtotal += item.price * item.qty;
        itemsBox.innerHTML += `
          <div class="flex items-center gap-3">
            <img src="${item.image}" class="w-14 h-14 object-cover rounded-md"/>
            <div class="flex-1">
              <div class="flex justify-between">
                <span>${item.name}</span>
                <span>${formatBRL(item.price*item.qty)}</span>
              </div>
              <div class="mt-1 flex items-center gap-2">
                <button onclick="updateQty('${item.id}', ${item.qty-1})" class="px-2 py-1 bg-gray-100">−</button>
                <span>${item.qty}</span>
                <button onclick="updateQty('${item.id}', ${item.qty+1})" class="px-2 py-1 bg-gray-100">+</button>
                <button onclick="removeFromCart('${item.id}')" class="ml-2 text-red-500 text-sm">Remover</button>
              </div>
            </div>
          </div>`;
      });
      document.getElementById("subtotal").textContent = formatBRL(subtotal);
      document.getElementById("total").textContent = formatBRL(subtotal);
      document.getElementById("cartCount").textContent = cart.reduce((s,i)=>s+i.qty,0);
    }

    function addToCart(id){
      const product = products.find(p => p.id === id);
      const found = cart.find(i => i.id === id);
      if(found){ found.qty++; }
      else{ cart.push({...product, qty:1}); }
      renderCart();
    }

    function updateQty(id, qty){
      if(qty <= 0){ removeFromCart(id); return; }
      cart = cart.map(i => i.id===id ? {...i, qty} : i);
      renderCart();
    }

    function removeFromCart(id){
      cart = cart.filter(i => i.id !== id);
      renderCart();
    }

    function clearCart(){
      cart = [];
      renderCart();
    }

    function checkout(){
      if(!cart.length) return;
      let msg = "Olá! Gostaria de fazer um pedido:%0A";
      cart.forEach((item,i)=>{
        msg += `${i+1}. ${item.name} — ${item.qty} x ${formatBRL(item.price)} = ${formatBRL(item.qty*item.price)}%0A`;
      });
      msg += `%0ATotal: ${document.getElementById("total").textContent}`;
      const url = `https://wa.me/${MY_WHATSAPP_NUMBER}?text=${msg}`;
      window.open(url, "_blank");
    }

    document.getElementById("toggleCart").addEventListener("click", ()=>{
      document.getElementById("cartBox").classList.toggle("hidden");
    });
    document.getElementById("checkoutBtn").addEventListener("click", checkout);
    document.getElementById("clearCart").addEventListener("click", clearCart);

    renderProducts();
  </script>
</body>
</html>
